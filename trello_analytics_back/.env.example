# Скопируйте в .env и заполните. Файл .env в git не коммитится.
# Key: https://trello.com/power-ups/admin → ваш Power-Up → API key
# Token: ссылка «Token» на той же странице (scope: read,write)
# Spike CLI (cmd/trello-spike) uses KEY/TOKEN/BOARD_ID read-only for API research.

TRELLO_API_KEY=
TRELLO_TOKEN=

# ID доски (из URL: trello.com/b/<BOARD_ID>/...)
TRELLO_BOARD_ID=

# Имя колонки на доске (точное совпадение). Пример: Бэклог
TRELLO_LIST_NAME=Бэклог

# Опционально: базовый URL репозитория для ссылок в карточке
# Пример: https://github.com/somedeveloper1/open_spec_common
OPENSPEC_REPO_URL=https://github.com/somedeveloper1/open_spec_common
# Ветка по умолчанию в этом репо — master (не main)
OPENSPEC_REPO_BRANCH=master

# Участники по ролям — username из Trello через запятую (без @).
# Посмотреть список: node scripts/trello/_list-board.mjs
# Пример: kew80,lildar,ilyador
TRELLO_MEMBERS_BACKEND=
TRELLO_MEMBERS_FRONTEND=
TRELLO_MEMBERS_QA=

# Как назначать на карточку, если в списке несколько человек:
#   first — только первого из каждого задействованного списка (по умолчанию)
#   all   — всех из задействованных списков
TRELLO_ASSIGN_MODE=first
