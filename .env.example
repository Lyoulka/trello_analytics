# Скопируйте в .env в корне workspace (рядом с docker-compose.yml).
# Файл .env в Git не коммитится.

# --- PostgreSQL ---
POSTGRES_USER=trello
POSTGRES_PASSWORD=trello_dev_password
POSTGRES_DB=trello_analytics
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
# Хост БД внутри Compose-сети — имя сервиса postgres (не localhost)
DATABASE_URL=postgres://trello:trello_dev_password@postgres:5432/trello_analytics?sslmode=disable
HTTP_ADDR=:8080
APP_ENV=development

# --- Frontend (Vite) ---
FRONTEND_PORT=5173
# Браузер ходит на Vite; API проксируется на backend внутри сети Compose
VITE_API_PROXY_TARGET=http://backend:8080
